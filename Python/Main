"""
Multi-MCU logger + OSC streamer with AUTO COM PORT DETECTION
- Auto-discovers M5Atom/Arduino devices
- Persistent device IDs based on serial number/description
- Per-MCU CSV logging and OSC streaming
- Format: idNum,imu_x,imu_y,imu_z,accel_x,accel_y,accel_z (7 values)
"""

from pythonosc import udp_client
import serial
import serial.tools.list_ports
import time
import csv
import os
import threading

# ------------- USER CONFIG -------------

# OSC target (Max)
MAX_OSC_IP = "127.0.0.1"
MAX_OSC_PORT = 7400

# Serial settings
BAUD_RATE = 115200
SERIAL_TIMEOUT = 0.001

# Delay between reading each port (seconds)
PORT_READ_DELAY = 0.001

# Auto-detect settings
AUTO_DETECT = True  # Set to False to use manual COM_PORTS list
DEVICE_FILTER = ["USB", "Serial", "CH340", "CP210", "UART"]  # Keywords to identify devices

# Manual COM ports (only used if AUTO_DETECT = False)
MANUAL_COM_PORTS = ["COM3", "COM9"]

# CSV naming mode: "auto" uses serial numbers, "manual" uses list below
CSV_NAMING_MODE = "auto"
MANUAL_CSV_NAMES = ["PID_1", "PID_2"]

# Threading
USE_THREADS = False

# ------------- END CONFIG ------------- 


def discover_devices():
    """
    Auto-discover connected serial devices and assign persistent IDs.
    Returns list of (port_name, serial_number, description, device_id)
    """
    print("\n[DISCOVERY] Scanning for devices...")
    ports = serial.tools.list_ports.comports()
    
    devices = []
    device_map = {}  # Map serial numbers to IDs for persistence
    
    for port in ports:
        # Check if port matches our filter
        if AUTO_DETECT:
            matches = any(keyword.lower() in port.description.lower() or 
                         keyword.lower() in str(port.manufacturer).lower()
                         for keyword in DEVICE_FILTER)
            if not matches:
                continue
        
        # Get unique identifier (prefer serial number, fallback to port)
        serial_num = port.serial_number if port.serial_number else port.device
        
        # Assign persistent device ID
        if serial_num not in device_map:
            device_map[serial_num] = len(device_map) + 1
        
        device_id = device_map[serial_num]
        
        devices.append({
            'port': port.device,
            'serial': serial_num,
            'description': port.description,
            'manufacturer': port.manufacturer,
            'device_id': device_id
        })
        
        print(f"  [{device_id}] {port.device} - {port.description}")
        print(f"      Serial: {serial_num}")
    
    if len(devices) == 0:
        print("  No devices found!")
    
    return devices


def open_serial_ports(devices):
    """Open all serial ports and return a list of device info + serial object."""
    serial_list = []
    for dev in devices:
        try:
            s = serial.Serial(dev['port'], BAUD_RATE, timeout=SERIAL_TIMEOUT)
            time.sleep(0.1)
            s.reset_input_buffer()
            
            dev['serial_obj'] = s
            serial_list.append(dev)
            print(f"[OK] Opened {dev['port']} (Device ID: {dev['device_id']})")
        except Exception as e:
            print(f"[ERROR] Cannot open {dev['port']}: {e}")
    
    return serial_list


def read_one_sample(serial_obj, max_attempts=5):
    """
    Try to read one valid sample with 7 values: 
    idNum,imu_x,imu_y,imu_z,accel_x,accel_y,accel_z
    Returns dict with parsed values or None if no valid data.
    """
    for _ in range(max_attempts):
        received_line = serial_obj.readline()
        if not received_line:
            continue
            
        cleaned_line = received_line.decode("utf-8", errors="replace").rstrip("\r\n")
        if cleaned_line == "":
            continue
        
        # Skip debug messages from Arduino
        if "Beep boop" in cleaned_line or "Initializing" in cleaned_line or "Found" in cleaned_line or "Setup complete" in cleaned_line:
            continue
            
        parts = cleaned_line.split(",")
        
        # Expect exactly 7 values
        if len(parts) != 7:
            continue
            
        try:
            values = [float(p) for p in parts]
            # Parse into named dict for clarity
            data = {
                'id': int(values[0]),
                'imu_x': values[1],
                'imu_y': values[2],
                'imu_z': values[3],
                'accel_x': values[4],
                'accel_y': values[5],
                'accel_z': values[6]
            }
            return data
        except (ValueError, IndexError):
            continue
    
    return None


def process_port_loop(device, writer, print_data, osc_client, stop_event):
    """Worker that reads from a port continuously."""
    start_time = time.time()
    port_name = device['port']
    device_id = device['device_id']

    try:
        while not stop_event.is_set():
            data = read_one_sample(device['serial_obj'])
            
            if data is not None:
                rel_time = time.time() - start_time
                
                # CSV row: timestamp, idNum, imu_x, imu_y, imu_z, accel_x, accel_y, accel_z
                row = [
                    rel_time,
                    data['id'],
                    data['imu_x'],
                    data['imu_y'],
                    data['imu_z'],
                    data['accel_x'],
                    data['accel_y'],
                    data['accel_z']
                ]

                if writer is not None:
                    writer.writerow(row)

                if print_data:
                    print(f"[Dev{device_id}:{port_name}] ID:{data['id']} "
                          f"IMU:({data['imu_x']:.2f},{data['imu_y']:.2f},{data['imu_z']:.2f}) "
                          f"Accel:({data['accel_x']:.3f},{data['accel_y']:.3f},{data['accel_z']:.3f})")

                if osc_client is not None:
                    # Use persistent device_id for OSC routing
                    base = f"/imu/{device_id}"
                    
                    # Send orientation (yaw, pitch, roll)
                    osc_client.send_message(f"{base}/yaw", data['imu_x'])
                    osc_client.send_message(f"{base}/pitch", data['imu_y'])
                    osc_client.send_message(f"{base}/roll", data['imu_z'])
                    
                    # Send acceleration
                    osc_client.send_message(f"{base}/accel_x", data['accel_x'])
                    osc_client.send_message(f"{base}/accel_y", data['accel_y'])
                    osc_client.send_message(f"{base}/accel_z", data['accel_z'])

    except Exception as e:
        print(f"[ERROR] Port {port_name} loop error: {e}")


def round_robin_loop(serial_list, writers, print_data, osc_client, stop_event):
    """
    Strict sequential alternation: reads one sample from each port in order.
    """
    start_time = time.time()
    port_index = 0
    
    while not stop_event.is_set():
        idx = port_index % len(serial_list)
        device = serial_list[idx]
        port_name = device['port']
        device_id = device['device_id']
        
        # Try to read from this specific port
        data = read_one_sample(device['serial_obj'])
        
        if data is not None:
            rel_time = time.time() - start_time
            
            row = [
                rel_time,
                data['id'],
                data['imu_x'],
                data['imu_y'],
                data['imu_z'],
                data['accel_x'],
                data['accel_y'],
                data['accel_z']
            ]

            writer = writers[idx]
            if writer is not None:
                writer.writerow(row)

            if print_data:
                print(f"[Dev{device_id}:{port_name}] ID:{data['id']} "
                      f"IMU:({data['imu_x']:.2f},{data['imu_y']:.2f},{data['imu_z']:.2f}) "
                      f"Accel:({data['accel_x']:.3f},{data['accel_y']:.3f},{data['accel_z']:.3f})")

            # Send OSC using persistent device_id
            if osc_client is not None:
                base = f"/imu/{device_id}"
                
                osc_client.send_message(f"{base}/yaw", data['imu_x'])
                osc_client.send_message(f"{base}/pitch", data['imu_y'])
                osc_client.send_message(f"{base}/roll", data['imu_z'])
                
                osc_client.send_message(f"{base}/accel_x", data['accel_x'])
                osc_client.send_message(f"{base}/accel_y", data['accel_y'])
                osc_client.send_message(f"{base}/accel_z", data['accel_z'])
            
            port_index += 1
            time.sleep(PORT_READ_DELAY)
        else:
            port_index += 1
            time.sleep(0.0001)


def main():
    print("=" * 60)
    print("  IMU OSC BRIDGE - Auto Device Detection")
    print("=" * 60)
    
    # Discover or use manual ports
    if AUTO_DETECT:
        devices = discover_devices()
        if len(devices) == 0:
            print("\nNo devices found. Check connections or set AUTO_DETECT=False")
            return
    else:
        # Manual mode - create device list from manual ports
        devices = []
        for i, port in enumerate(MANUAL_COM_PORTS):
            devices.append({
                'port': port,
                'serial': f"manual_{i}",
                'description': "Manual entry",
                'manufacturer': "N/A",
                'device_id': i + 1
            })
    
    # Open serial ports
    serial_list = open_serial_ports(devices)
    if len(serial_list) == 0:
        print("No serial ports opened. Exiting.")
        return

    # Setup OSC client
    osc_client = udp_client.SimpleUDPClient(MAX_OSC_IP, MAX_OSC_PORT)
    print(f"\n[OK] OSC client ready -> {MAX_OSC_IP}:{MAX_OSC_PORT}")

    print(f"\nSequential mode: {PORT_READ_DELAY*1000:.1f}ms delay between ports")
    print("Mode: r = record only, p = print only, rp/pr = record+print")
    user_input = input(">> ").strip().lower()
    record = user_input == "r" or user_input in ("rp", "pr")
    print_data = user_input == "p" or user_input in ("rp", "pr")

    # Prepare CSV writers
    writers = []
    files = []
    
    for device in serial_list:
        if record:
            # Generate CSV filename
            if CSV_NAMING_MODE == "auto":
                # Use serial number or device ID
                safe_serial = device['serial'].replace('/', '_').replace('\\', '_')
                csv_file_name = f"device_{device['device_id']}_{safe_serial}"
            else:
                # Use manual names
                idx = serial_list.index(device)
                if idx < len(MANUAL_CSV_NAMES):
                    csv_file_name = MANUAL_CSV_NAMES[idx]
                else:
                    csv_file_name = f"device_{device['device_id']}"
            
            csv_path = csv_file_name + ".csv"
            
            if os.path.exists(csv_path):
                print(f"WARNING: '{csv_path}' already exists. Overwrite? (y/n)")
                choice = input(">> ").strip().lower()
                if choice != "y":
                    print("Canceled by user. Closing ports and exiting.")
                    for dev in serial_list:
                        dev['serial_obj'].close()
                    return
            
            try:
                f = open(csv_path, "w", newline="")
                w = csv.writer(f, delimiter=",")
                w.writerow(["timestamp", "id", "imu_x", "imu_y", "imu_z", "accel_x", "accel_y", "accel_z"])
                files.append(f)
                writers.append(w)
                print(f"[OK] Logging Device {device['device_id']} -> {csv_path}")
            except Exception as e:
                print(f"[ERROR] cannot open '{csv_path}': {e}")
                files.append(None)
                writers.append(None)
        else:
            files.append(None)
            writers.append(None)

    stop_event = threading.Event()

    try:
        if USE_THREADS:
            threads = []
            for idx, device in enumerate(serial_list):
                t = threading.Thread(
                    target=process_port_loop,
                    args=(device, writers[idx], print_data, osc_client, stop_event),
                    daemon=True,
                )
                t.start()
                threads.append(t)
            print("\n[RUNNING] Threaded mode. Press Ctrl+C to stop.\n")
            while True:
                time.sleep(0.5)
        else:
            print("\n[RUNNING] Sequential mode. Press Ctrl+C to stop.\n")
            round_robin_loop(serial_list, writers, print_data, osc_client, stop_event)

    except KeyboardInterrupt:
        print("\n\n[STOPPING] Shutting down...")

    finally:
        stop_event.set()
        for f in files:
            if f is not None:
                f.close()
        for device in serial_list:
            try:
                device['serial_obj'].close()
            except Exception:
                pass
        print("[OK] Clean exit. See you cyberspace cowboy.\n")


if __name__ == "__main__":
    main()
