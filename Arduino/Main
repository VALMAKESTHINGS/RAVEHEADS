// --- ADSR Parameters --- //
float attackTime = 0.9f;
float decayTime = 0.9f;
float sustainLevel = 1.0f;
float releaseTime = 0.9f;

// --- Sine volume control --- //
bool isPlaying = false;
const int16_t MAX_VOLUME = 30000;
// --- Pink noise volume control --- //
bool isNoisePlaying = false;

// --- delta variables --- //
float deltaThresh = 10.0f;
long deltaCurrentX, deltaCurrentY, deltaCurrentZ = 0.0;
long cumulativeDeltaX, cumulativeDeltaY, cumulativeDeltaZ = 0;
double prev_imu_x, prev_imu_y, prev_imu_z = 0.0;
double delta_imu_x, delta_imu_y, delta_imu_z = 0.0;

// --- Quantized trigger --- //
float rangeMin = 0.0f;
float rangeMax = 360.0f;
float triggerSpacing = 8.0f;

int totalBins = (rangeMax - rangeMin) / triggerSpacing;

static int lastTriggerBinX = -1;
static int lastTriggerBinY = -1;
static int lastTriggerBinZ = -1;


// --- IMU --- //
// FIXED: Different report intervals for each sensor to prevent conflicts
#define ORIENTATION_INTERVAL_US 5000  // 200Hz for orientation (faster)
#define ACCEL_INTERVAL_US 10000       // 100Hz for accelerometer

#ifdef FAST_MODE
  sh2_SensorId_t reportType = SH2_GYRO_INTEGRATED_RV;
  long reportIntervalUs = 2000;
#else
  sh2_SensorId_t reportType = SH2_ARVR_STABILIZED_RV;
  long reportIntervalUs = ORIENTATION_INTERVAL_US;
#endif

#define BNO08X_RESET -1
Adafruit_BNO08x  bno08x(BNO08X_RESET);
sh2_SensorValue_t sensorValue;

struct euler_t {
  float yaw;
  float pitch;
  float roll;
} ypr;

// FIXED: Added data freshness tracking
float imu_x, imu_y, imu_z;
float accel_x, accel_y, accel_z;
bool newOrientationData = false;
bool newAccelData = false;
unsigned long lastOrientationTime = 0;
unsigned long lastAccelTime = 0;

// Calibration offsets
float imu_x_offset = 0.0f;
float imu_y_offset = 0.0f;
float imu_z_offset = 0.0f;
float accel_x_offset = 0.0f;
float accel_y_offset = 0.0f;
float accel_z_offset = 0.0f;

// Variables to track angle for each axis
float prevAngle_x = 0.0f, prevAngle_y = 0.0f, prevAngle_z = 0.0f;
float totalAngle_x = 0.0f, totalAngle_y = 0.0f, totalAngle_z = 0.0f;
bool isFirstReading = true;

void quaternionToEuler(float qr, float qi, float qj, float qk, euler_t* ypr, bool degrees = false) {

    float sqr = sq(qr);
    float sqi = sq(qi);
    float sqj = sq(qj);
    float sqk = sq(qk);

    ypr->yaw = atan2(2.0 * (qi * qj + qk * qr), (sqi - sqj - sqk + sqr));
    ypr->pitch = asin(-2.0 * (qi * qk - qj * qr) / (sqi + sqj + sqk + sqr));
    ypr->roll = atan2(2.0 * (qj * qk + qi * qr), (-sqi - sqj + sqk + sqr));

    if (degrees) {
      ypr->yaw *= RAD_TO_DEG;
      ypr->pitch *= RAD_TO_DEG;
      ypr->roll *= RAD_TO_DEG;
    }
}

void quaternionToEulerRV(sh2_RotationVectorWAcc_t* rotational_vector, euler_t* ypr, bool degrees = false) {
    quaternionToEuler(rotational_vector->real, rotational_vector->i, rotational_vector->j, rotational_vector->k, ypr, degrees);
}

// --- LEDS --- //
const uint8_t dataPin = 26;
const uint8_t clockPin = 32;
const uint16_t ledCount = 4;
float brightness = 0.0f;
rgb_color colors[ledCount];

Pololu::APA102<dataPin, clockPin> ledStrip;

// --- grain gen variables --- // 
int freqOut = SINE_FREQUENCY;
int16_t sineVolume = MAX_VOLUME;
float noiseVolume = 0.0;
bool isVibrating, shouldVibrate = false;
uint32_t signalDuration;

elapsedMicros pulseTimeUS = 0;

// --- Print & Record variables --- //
int printRefreshRate = 10 * 1000;
unsigned long previousPrintMicros = 0;
bool debugPrint = true;

// --- Calibration function --- //
void calibrateIMU() {
  Serial.println("=== Starting 20-second calibration ===");
  Serial.println("Keep the device still!");
  
  float sum_imu_x = 0.0f;
  float sum_imu_y = 0.0f;
  float sum_imu_z = 0.0f;
  float sum_accel_x = 0.0f;
  float sum_accel_y = 0.0f;
  float sum_accel_z = 0.0f;
  int sample_count = 0;
  
  unsigned long calibration_start = millis();
  unsigned long last_progress = millis();
  
  // Flash LED to show calibration in progress
  M5.dis.drawpix(0, 0xffff00); // Yellow during calibration
  
  while (millis() - calibration_start < 20000) { // 20 seconds
    
    // Read sensor data
    while (bno08x.getSensorEvent(&sensorValue)) {
      switch (sensorValue.sensorId) {
        case SH2_ARVR_STABILIZED_RV:
          quaternionToEulerRV(&sensorValue.un.arvrStabilizedRV, &ypr, true);
          sum_imu_x += ypr.yaw;
          sum_imu_y += ypr.pitch;
          sum_imu_z += ypr.roll;
          sample_count++;
          break;
          
        case SH2_ACCELEROMETER:
          sum_accel_x += sensorValue.un.accelerometer.x;
          sum_accel_y += sensorValue.un.accelerometer.y;
          sum_accel_z += sensorValue.un.accelerometer.z;
          break;
      }
    }
    
    // Print progress every second
    if (millis() - last_progress >= 1000) {
      int seconds_remaining = 20 - ((millis() - calibration_start) / 1000);
      Serial.printf("Calibrating... %d seconds remaining (samples: %d)\n", seconds_remaining, sample_count);
      last_progress = millis();
      
      // Blink LED
      if ((millis() / 500) % 2 == 0) {
        M5.dis.drawpix(0, 0xffff00);
      } else {
        M5.dis.drawpix(0, 0x000000);
      }
    }
    
    delay(1);
  }
  
  // Calculate averages as offsets
  if (sample_count > 0) {
    imu_x_offset = sum_imu_x / sample_count;
    imu_y_offset = sum_imu_y / sample_count;
    imu_z_offset = sum_imu_z / sample_count;
    accel_x_offset = sum_accel_x / sample_count;
    accel_y_offset = sum_accel_y / sample_count;
    accel_z_offset = sum_accel_z / sample_count;
    
    Serial.println("=== Calibration Complete ===");
    Serial.printf("IMU Offsets - X: %.3f, Y: %.3f, Z: %.3f\n", imu_x_offset, imu_y_offset, imu_z_offset);
    Serial.printf("Accel Offsets - X: %.3f, Y: %.3f, Z: %.3f\n", accel_x_offset, accel_y_offset, accel_z_offset);
    Serial.printf("Total samples collected: %d\n", sample_count);
  } else {
    Serial.println("WARNING: No samples collected during calibration!");
  }
  
  // Flash green to show calibration done
  for (int i = 0; i < 3; i++) {
    M5.dis.drawpix(0, 0x00ff00);
    delay(200);
    M5.dis.drawpix(0, 0x000000);
    delay(200);
  }
}

// --- Setup --- //
void setup() {
  millis();
  Serial.begin(115200);
  M5.begin(true, false, true);
  M5.dis.drawpix(0, 0xff8700);
  Wire.begin(32, 26);
  Serial.println("Beep boop, starting up");
  delay(100);
  
  // --- Init IMU --- //
  Serial.println("Initializing BNO08x IMU...");
  if (!bno08x.begin_I2C()) {
    Serial.println("Failed to find BNO08x chip");
    for (int i = 0; i < 3; i++) {
      M5.dis.drawpix(0, 0xff00ff);
      delay(200);
      M5.dis.drawpix(0, 0x000000);
      delay(200);
    }
  } else {
    Serial.println("BNO08x Found!");
    setReports(reportType, ORIENTATION_INTERVAL_US);
  }
  
  // FIXED: Enable reports with different intervals
  if (!bno08x.enableReport(SH2_ACCELEROMETER, ACCEL_INTERVAL_US)) {
    Serial.println("Could not enable accelerometer");
  } else {
    Serial.println("Accelerometer enabled at 100Hz");
  }
  
  if (!bno08x.enableReport(SH2_ARVR_STABILIZED_RV, ORIENTATION_INTERVAL_US)) {
    Serial.println("Could not enable orientation");
  } else {
    Serial.println("Orientation enabled at 200Hz");
  }
  
  delay(100);
  M5.dis.drawpix(0, 0x01ff00);
  Serial.println("BNO08x initialization complete!");
  
  // Run calibration
  calibrateIMU();
  
  Serial.println("Setup complete. Have a nice day boss :)");
  delay(100);
}

// --- loop --- //
void loop() {
  const unsigned long nowMicros = micros();
  M5.update();

  // FIXED: Better sensor event handling with data freshness tracking
  int eventCount = 0;
  const int MAX_EVENTS_PER_LOOP = 10; // Prevent infinite loop
  
  while (bno08x.getSensorEvent(&sensorValue) && eventCount < MAX_EVENTS_PER_LOOP) {
    eventCount++;
    
    switch (sensorValue.sensorId) {

      case SH2_ARVR_STABILIZED_RV:
        quaternionToEulerRV(&sensorValue.un.arvrStabilizedRV, &ypr, true);
        imu_x = ypr.yaw - imu_x_offset;
        imu_y = ypr.pitch - imu_y_offset;
        imu_z = ypr.roll - imu_z_offset;
        newOrientationData = true;
        lastOrientationTime = nowMicros;
        break;

      case SH2_ACCELEROMETER:
        accel_x = sensorValue.un.accelerometer.x - accel_x_offset;
        accel_y = sensorValue.un.accelerometer.y - accel_y_offset;
        accel_z = sensorValue.un.accelerometer.z - accel_z_offset;
        newAccelData = true;
        lastAccelTime = nowMicros;
        break;
    }
  }

  // FIXED: Check for sensor timeout (data should arrive every ~5-10ms)
  if (nowMicros - lastOrientationTime > 50000) { // 50ms timeout
    Serial.println("WARNING: Orientation data timeout!");
  }
  if (nowMicros - lastAccelTime > 50000) { // 50ms timeout
    Serial.println("WARNING: Accelerometer data timeout!");
  }

  // --- Serial print ---
  if (debugPrint && (nowMicros - previousPrintMicros >= printRefreshRate)) {
    // FIXED: Only print when we have fresh data from both sensors
    if (newOrientationData || newAccelData) {
      Serial.printf(
        "%i,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f\n",
        idNum, imu_x, imu_y, imu_z,
        accel_x, accel_y, accel_z
      );
      newOrientationData = false;
      newAccelData = false;
    }
    previousPrintMicros = nowMicros;
  }
  
  // FIXED: Reduced delay to prevent blocking sensor reads
  delayMicroseconds(100); // Much shorter delay
}


/////////////////////////////////////////
//     FUNCTIONS FOR GRAIN FEEDBACK    //
/////////////////////////////////////////

void GenerateGrain(float freq, bool* vibrateFlag, int16_t* amplitude_value, float* noise_amp) {
  signalDuration = 1000 * 1000 / freq;

  if (isVibrating && (pulseTimeUS >= signalDuration)) {
    StopPulse();
  }

  if (*vibrateFlag == true) {
    if (isVibrating && (pulseTimeUS >= signalDuration)) {
      StopPulse();
    }
    if(pulseTimeUS >=  signalDuration) {
      StartPulse(freqOut, amplitude_value, noise_amp);
      *vibrateFlag = false;
    }
  }
}

void StartPulse(float freq, int16_t* amplitude_value, float* noise_amp) {
  isPlaying = true;
  adsr.keyOn();
  sineWave.setFrequency(freq);
  M5.dis.drawpix(0, 0x0000ff);
  isVibrating = true;
  pulseTimeUS = 0;
}

void StopPulse() {
  adsr.keyOff();
  M5.dis.drawpix(0, 0xff0000);
  isVibrating = false;
  M5.dis.drawpix(0, 0x01ff00);
  pulseTimeUS = 0;
}

void generateQuantizedTrigger(float imuAngle, int& lastTriggerBin) {
    float angle = fmod((imuAngle - rangeMin + 360.0f), 360.0f) + rangeMin;
    int currentBin = (int)((angle - rangeMin) / triggerSpacing);

    if (currentBin != lastTriggerBin) {
        shouldVibrate = true;
        lastTriggerBin = currentBin;
    }
}

///////////////////////////////
//     FUNCTION FOR IMU      //
///////////////////////////////

void setReports(sh2_SensorId_t reportType, long report_interval) {
  Serial.println("Setting desired reports");
  if (! bno08x.enableReport(reportType, report_interval)) {
    Serial.println("Could not enable stabilized remote vector");
  }
}

float fmap(float x, float in_min, float in_max, float out_min, float out_max) {
  return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

void quaternionToEulerGI(sh2_GyroIntegratedRV_t* rotational_vector, euler_t* ypr, bool degrees = false) {
    quaternionToEuler(rotational_vector->real, rotational_vector->i, rotational_vector->j, rotational_vector->k, ypr, degrees);
}

float mapAngle(float input) {
  return fmap(input, -180.0, 180.0, 0.0, 1.0);
}

void updateTotalAngles(float current_x, float current_y, float current_z) {
  if (isFirstReading) {
    prevAngle_x = current_x;
    prevAngle_y = current_y;
    prevAngle_z = current_z;
    isFirstReading = false;
    return;
  }
  
  float diff_x = current_x - prevAngle_x;
  if (diff_x > 180) diff_x -= 360;
  else if (diff_x < -180) diff_x += 360;
  totalAngle_x += diff_x;
  prevAngle_x = current_x;
  
  float diff_y = current_y - prevAngle_y;
  if (diff_y > 180) diff_y -= 360;
  else if (diff_y < -180) diff_y += 360;
  totalAngle_y += diff_y;
  prevAngle_y = current_y;
  
  float diff_z = current_z - prevAngle_z;
  if (diff_z > 180) diff_z -= 360;
  else if (diff_z < -180) diff_z += 360;
  totalAngle_z += diff_z;
  prevAngle_z = current_z;
}

